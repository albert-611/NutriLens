# NutriLens Environment Configuration Example
# Copy this file to .env.local for local development. Never commit real keys.

# Supabase Public Configuration (Safe for frontend bundle)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Backend / Server-side Secrets (Edge Functions ONLY - NEVER prefix with VITE_)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# GEMINI_API_KEY=AIzaSy...
